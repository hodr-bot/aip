[Unit]
Description=AIP VPN daemon (WireGuard + fail-closed kill switch)
After=network-pre.target
Before=network-online.target
Wants=network-pre.target

[Service]
Type=simple
ExecStart=/usr/local/bin/aipd serve
Environment=AIPD_STATE_DIR=/var/lib/aipd
Restart=on-failure
RestartSec=5
# Privilege boundary: root owns the tunnel and nftables, nobody else.
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
StateDirectory=aipd
StateDirectoryMode=0700
RuntimeDirectory=aipd

[Install]
WantedBy=multi-user.target
