{
  "manifest_version": 2,
  "name": "PIA Core",
  "version": "0.1.1",
  "description": "PIA proxy with shared core: 12h token refresh, fail-closed kill switch.",
  "incognito": "spanning",
  "background": {
    "scripts": [
      "vendor/kotlin-kotlin-stdlib.js",
      "vendor/pia-core.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "PIA Core — Server Choice",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "alarms",
    "storage",
    "proxy",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>",
    "https://www.privateinternetaccess.com/*",
    "https://serverlist.piaservers.net/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "pia-core@local",
      "strict_min_version": "91.1.0"
    }
  }
}
