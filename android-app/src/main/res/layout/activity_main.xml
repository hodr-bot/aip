<?xml version="1.0" encoding="utf-8"?>
<!-- AIP VPN home: status pill, hero power button, server card, options, footer.
     Same view ids as before, so MainActivity wiring is untouched. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pia_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:id="@+id/loginContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AIP VPN"
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="@color/pia_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fast private tunnel"
                android:textColor="@color/pia_muted"
                android:layout_marginBottom="20dp" />

            <EditText
                android:id="@+id/username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="PIA username"
                android:inputType="text"
                android:textColor="@color/pia_text"
                android:textColorHint="@color/pia_muted"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="PIA password"
                android:inputType="textPassword"
                android:textColor="@color/pia_text"
                android:textColorHint="@color/pia_muted"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Log in" />

            <TextView
                android:id="@+id/loginStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not logged in"
                android:textColor="@color/pia_muted"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mainContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header: brand + status pill. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AIP VPN"
                    android:textColor="@color/pia_accent"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/connStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pill_off"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="Off"
                    android:textColor="@color/pia_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Hero power button. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="6dp"
                android:gravity="center"
                android:orientation="vertical">

                <Button
                    android:id="@+id/connect"
                    android:layout_width="176dp"
                    android:layout_height="176dp"
                    android:background="@drawable/hero_off"
                    android:text="Connect"
                    android:textColor="@color/pia_accent"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/connectProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="176dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/errorDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:textColor="@color/pia_error" />
            </LinearLayout>

            <!-- Server card: current choice + change action. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:id="@+id/selectedStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tap Change to pick a server"
                    android:textColor="@color/pia_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/pickServer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Change" />
            </LinearLayout>

            <!-- Options card. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <CheckBox
                    android:id="@+id/allowLan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Allow local network"
                    android:textColor="@color/pia_text"
                    android:buttonTint="@color/pia_accent" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="No effect while Android “Block connections without VPN” is on: the system forces one or the other, no app can have both."
                    android:textColor="@color/pia_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Footer: quiet secondary actions. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/refresh"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Refresh"
                    android:textColor="@color/pia_muted" />

                <Button
                    android:id="@+id/vpnSettings"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VPN settings"
                    android:textColor="@color/pia_muted" />

                <Button
                    android:id="@+id/switchAccount"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Account"
                    android:textColor="@color/pia_muted" />
            </LinearLayout>

            <TextView
                android:id="@+id/appVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:textSize="11sp"
                android:textColor="@color/pia_muted" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
